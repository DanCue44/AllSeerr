extends ../_partials/layout.pug

block content
  +text
    | #{body}
  -
    var rows = [];
    if (requestedBy) {
      rows.push({ name: labels.requestedBy, value: requestedBy.replace(/\.|@/g, function (x) { return x + '\ufeff'; }) });
    }
    rows = rows.concat(mediaExtra || []);
  +mediaCard({ title: mediaName, url: actionUrl, imageUrl: imageUrl, rows: rows, timestamp: timestamp })
  if actionUrl
    +button(actionUrl, actionLabel || labels.viewInApp)
