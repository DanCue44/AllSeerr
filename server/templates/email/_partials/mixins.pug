//- AllSeerr "Ambient" look for email: the charcoal palette from
//- src/styles/allseerr-theme.css with the orange accent. Everything is
//- styled inline and colors are repeated as bgcolor attributes, since many
//- mail apps drop <style> blocks or CSS backgrounds.
//-
//- The dark look is the default. Mail apps that follow the system
//- appearance (Apple Mail, iOS Mail) switch to the light palette `L`
//- through the color role classes below (as-bg-*, as-c-*, as-b-line),
//- which layout.pug overrides in a prefers-color-scheme media query.
-
  var C = {
    ground: '#202124',
    surface: '#2b2c30',
    tile: '#25262a',
    line: '#3d3e43',
    ink: '#f1f1f2',
    inkSoft: '#dddde0',
    inkMuted: '#c0c0c5',
    inkFaint: '#a6a6ac',
    accent: '#ec703e',
    accentSoft: '#f7b091',
  };
  //- Light mode, every text color at least 4.5:1 on the page and the card
  var L = {
    ground: '#f5f4f2',
    surface: '#ffffff',
    tile: '#edebe8',
    line: '#e2dfdb',
    ink: '#1f2023',
    inkSoft: '#3c4043',
    inkMuted: '#5f6368',
    inkFaint: '#6b6e73',
    accentSoft: '#a84a22',
  };
  //- Request status pills, dark first and the light mode pair after
  var P = {
    blue: { bg: '#1d3553', ink: '#a9cbff', lightBg: '#dce8fb', lightInk: '#1d4f91' },
    green: { bg: '#1c3a29', ink: '#93dcae', lightBg: '#dbf0e2', lightInk: '#1d6b3a' },
    red: { bg: '#472326', ink: '#ffaba6', lightBg: '#fbe1df', lightInk: '#a2302a' },
    amber: { bg: '#443519', ink: '#f4cf7c', lightBg: '#fbeed3', lightInk: '#7f5300' },
  };
  var F = {
    heading: "'Unbounded', 'Segoe UI', Helvetica, Arial, sans-serif",
    body: "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    mono: "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace",
  };
  var TABLE = { role: 'presentation', cellpadding: '0', cellspacing: '0', border: '0' };

//- One paragraph of body copy.
mixin text(muted)
  tr
    td(class=muted ? 'as-c-faint' : 'as-c-soft' style=`padding:0 4px 16px;font-family:${F.body};font-size:${muted ? '14px' : '16px'};line-height:${muted ? '21px' : '24px'};color:${muted ? C.inkFaint : C.inkSoft};`)
      div
        block

//- Orange pill button, a table so Outlook keeps the background.
mixin button(href, label)
  tr
    td.as-btn-wrap(align='center' style='padding:8px 4px 8px;')
      table.as-btn&attributes(TABLE)
        tr
          td(align='center' bgcolor=C.accent style=`border-radius:999px;background-color:${C.accent};`)
            a.as-btn-link(href=href target='_blank' style=`display:inline-block;padding:14px 32px;font-family:${F.body};font-size:15px;line-height:20px;font-weight:700;color:${C.ground};text-decoration:none;border-radius:999px;`)
              | #{label}

//- Stacked label and value; the label is small caps above the value so long
//- values (decline reasons, season lists) wrap cleanly on phones.
mixin detailRows(rows)
  if rows && rows.length
    table(width='100%' style='width:100%;')&attributes(TABLE)
      each row in rows
        tr
          td(style='padding:14px 0 0;')
            div.as-c-faint(style=`font-family:${F.body};font-size:11px;line-height:16px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:${C.inkFaint};`)
              | #{row.name}
            div.as-c-soft(style=`padding-top:2px;font-family:${F.body};font-size:15px;line-height:22px;color:${C.inkSoft};word-break:break-word;`)
              | #{row.value}

//- The title card: name, details, timestamp and cover art on the right.
mixin mediaCard(card)
  tr
    td(style='padding:4px 0 20px;')
      table.as-bg-surface.as-b-line(width='100%' bgcolor=C.surface style=`width:100%;background-color:${C.surface};border:1px solid ${C.line};border-radius:16px;border-collapse:separate;`)&attributes(TABLE)
        tr
          td.as-card-pad(valign='top' style='padding:20px;')
            if card.url
              div.as-h2.as-c-ink(style=`font-family:${F.heading};font-size:18px;line-height:24px;font-weight:700;color:${C.ink};word-break:break-word;`)
                a.as-title.as-c-ink(href=card.url target='_blank' style=`color:${C.ink};text-decoration:none;`)
                  | #{card.title}
            else
              div.as-h2.as-c-ink(style=`font-family:${F.heading};font-size:18px;line-height:24px;font-weight:700;color:${C.ink};word-break:break-word;`)
                | #{card.title}
            +detailRows(card.rows)
          if card.imageUrl
            td.as-cover-cell(valign='top' width='116' style='width:96px;padding:20px 20px 20px 0;')
              if card.url
                a.as-img-link(href=card.url target='_blank' style='display:block;text-decoration:none;')
                  img.as-cover(src=card.imageUrl alt='' width='96' style='display:block;width:96px;max-width:96px;height:auto;border:0;border-radius:10px;')
              else
                img.as-cover(src=card.imageUrl alt='' width='96' style='display:block;width:96px;max-width:96px;height:auto;border:0;border-radius:10px;')
        if card.timestamp
          tr
            td.as-card-foot.as-b-line.as-c-faint(colspan=card.imageUrl ? 2 : 1 style=`padding:12px 20px 14px;border-top:1px solid ${C.line};font-family:${F.body};font-size:13px;line-height:18px;color:${C.inkFaint};`)
              div #{card.timestamp}

//- Quoted user text such as an issue description or comment.
mixin quote(content)
  tr
    td(style='padding:0 0 20px;')
      table.as-bg-tile(width='100%' bgcolor=C.tile style=`width:100%;background-color:${C.tile};border-left:3px solid ${C.accent};border-radius:12px;border-collapse:separate;`)&attributes(TABLE)
        tr
          td.as-c-soft(style=`padding:14px 18px;font-family:${F.body};font-size:15px;line-height:23px;color:${C.inkSoft};white-space:pre-line;word-break:break-word;`)
            div #{content}

//- The header wordmark. With a light mode variant, both are sent and the
//- media query in layout.pug shows the one that fits; Outlook for Windows
//- never sees the light one.
mixin logo
  - var logoStyle = `display:block;width:168px;max-width:100%;height:auto;border:0;font-family:${F.heading};font-size:20px;font-weight:700;color:${C.ink};`
  if logoLightUrl
    img.as-logo-dark.as-c-ink(src=logoUrl alt=applicationTitle width='168' style=logoStyle)
    <!--[if !mso]><!-->
    div.as-logo-light(style='display:none;max-height:0;overflow:hidden;mso-hide:all;')
      img.as-c-ink(src=logoLightUrl alt=applicationTitle width='168' style=logoStyle)
    <!--<![endif]-->
  else
    img.as-c-ink(src=logoUrl alt=applicationTitle width='168' style=logoStyle)

//- Small colored pill for a request status such as Processing or Available.
mixin statusPill(status)
  - var tone = P[status.tone] || P.blue
  span(class=`as-pill-${status.tone}` style=`display:inline-block;padding:3px 10px;border-radius:999px;background-color:${tone.bg};font-family:${F.body};font-size:12px;line-height:18px;font-weight:700;letter-spacing:0.02em;color:${tone.ink};white-space:nowrap;`)
    | #{status.label}

//- Label and value side by side, like the lines under a Pushover message.
//- Values that are a status show as a pill.
mixin detailList(rows)
  if rows && rows.length
    table(width='100%' style='width:100%;')&attributes(TABLE)
      each row, i in rows
        tr
          td.as-dl-label.as-c-faint.as-b-line(valign='top' width='132' style=`width:132px;padding:9px 12px 9px 0;border-top:1px solid ${C.line};font-family:${F.body};font-size:13px;line-height:20px;color:${C.inkFaint};`)
            | #{row.name}
          td.as-c-ink.as-b-line(valign='top' style=`padding:9px 0;border-top:1px solid ${C.line};font-family:${F.body};font-size:14px;line-height:20px;font-weight:600;color:${C.ink};word-break:break-word;`)
            if row.status
              +statusPill(row.status)
            else
              | #{row.value}

//- The request card in the spirit of the Pushover message: a large poster,
//- the title in bold, the full overview, the details and a button.
mixin requestCard(card)
  tr
    td(style='padding:4px 0 20px;')
      table.as-bg-surface.as-b-line(width='100%' bgcolor=C.surface style=`width:100%;background-color:${C.surface};border:1px solid ${C.line};border-radius:18px;border-collapse:separate;`)&attributes(TABLE)
        if card.imageUrl
          tr
            td.as-poster-cell(style='padding:12px 12px 0;')
              - var posterStyle = `display:block;width:100%;max-width:534px;height:auto;border:0;border-radius:12px;background-color:${C.tile};font-family:${F.body};font-size:14px;line-height:20px;color:${C.inkMuted};`
              if card.url
                a.as-img-link(href=card.url target='_blank' style='display:block;text-decoration:none;')
                  img.as-poster.as-bg-tile(src=card.imageUrl alt=card.imageAlt width='534' style=posterStyle)
              else
                img.as-poster.as-bg-tile(src=card.imageUrl alt=card.imageAlt width='534' style=posterStyle)
        tr
          td.as-card-body(style='padding:20px 24px 24px;')
            div.as-h1.as-c-ink(style=`font-family:${F.heading};font-size:22px;line-height:29px;font-weight:700;color:${C.ink};word-break:break-word;`)
              if card.url
                a.as-title.as-c-ink(href=card.url target='_blank' style=`color:${C.ink};text-decoration:none;`)
                  | #{card.title}
              else
                | #{card.title}
            if card.byline
              div.as-c-muted(style=`padding-top:4px;font-family:${F.body};font-size:15px;line-height:22px;font-weight:600;color:${C.inkMuted};`)
                | #{card.byline}
            if card.overview
              div.as-c-soft(style=`padding-top:14px;font-family:${F.body};font-size:15px;line-height:24px;color:${C.inkSoft};word-break:break-word;`)
                | #{card.overview}
            if card.rows && card.rows.length
              div(style='padding-top:18px;')
                +detailList(card.rows)
            if card.url
              table.as-btn(style='margin-top:22px;')&attributes(TABLE)
                tr
                  td(align='center' bgcolor=C.accent style=`border-radius:999px;background-color:${C.accent};`)
                    a.as-btn-link(href=card.url target='_blank' style=`display:inline-block;padding:13px 30px;font-family:${F.body};font-size:15px;line-height:20px;font-weight:700;color:${C.ground};text-decoration:none;border-radius:999px;`)
                      | #{card.actionLabel}
