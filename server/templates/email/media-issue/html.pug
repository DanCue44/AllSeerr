extends ../_partials/layout.pug

block content
  +text
    | #{body}
  if issueComment
    +quote(issueComment)
  else if issueDescription
    +quote(issueDescription)
  +mediaCard({ title: mediaName, url: actionUrl, imageUrl: imageUrl, rows: extra, timestamp: timestamp })
  if actionUrl
    +button(actionUrl, labels.viewIssue)
